# Copy to .env and edit. Never commit .env. Values here are examples, not defaults you should keep.

# ---- core ----
MIRAGE_ENV=dev                         # dev | production (production locks down files, typed consent, secret/CORS checks)
MIRAGE_SECRET_KEY=                     # required in production: `python3 -c "import secrets;print(secrets.token_urlsafe(48))"`
MIRAGE_CORS_ORIGINS=http://localhost:3000   # comma list of dashboard origins; '*' is refused in production
MIRAGE_DB_URL=sqlite:///mirage.db
MIRAGE_DATA=./data                     # replica/video/consent files
PUBLIC_API_URL=http://localhost:8000   # baked into the web build (docker compose build arg)

# ---- safety ----
MIRAGE_ALLOW_PUBLIC_FILES=             # unset = on in dev, off in production (unsigned /v1/files/*)
MIRAGE_ALLOW_TYPED_CONSENT=            # unset = on in dev, off in production (typed-phrase consent)
MIRAGE_CONSENT_VOICE_MATCH=            # enforce | warn | off ; unset = enforce in production, warn in dev
MIRAGE_VOICE_MATCH_THRESHOLD=0.50      # cosine similarity; same speaker scored 0.82-0.91, different speakers <= 0.41 in our tests
MIRAGE_CONSENT_WHISPER=base.en
MIRAGE_SIGNED_URL_TTL=3600             # seconds a signed file link stays valid
MIRAGE_MODERATION_OLLAMA_MODEL=qwen3:8b   # '' disables the LLM classifier (blocklist only)
MIRAGE_BLOCKLIST=                      # extra comma-separated blocked terms
NEXT_PUBLIC_ALLOW_TYPED_CONSENT=       # dev only: show the typed fallback in the dashboard (rebuild web)

# ---- rate limits / sizes ----
MIRAGE_RATE_LIMIT=on                   # off disables the middleware (tests only)
MIRAGE_TRUST_PROXY=0                   # 1 only behind your own reverse proxy: use X-Forwarded-For for client IPs
MIRAGE_RL_IP=600/60                    # limit/window-seconds, per client IP (all requests)
MIRAGE_RL_KEY=240/60                   # per API key (all requests)
MIRAGE_RL_SIGNUP=5/600                 # per IP (default 5/600 in production, 60/60 in dev)
MIRAGE_RL_VIDEO=10/60                  # POST /v1/videos, /v1/video-jobs
MIRAGE_RL_CHECKOUT=10/60
MIRAGE_RL_CONVERSATION=20/60
MIRAGE_RL_REPLICA=20/60
MIRAGE_RL_MODERATION=30/60
MIRAGE_RL_WEBHOOK=120/60
MIRAGE_MAX_BODY_BYTES=2097152          # JSON bodies
MIRAGE_MAX_UPLOAD_BYTES=26214400       # multipart bodies (consent audio, knowledge files)
MIRAGE_MAX_TRAIN_VIDEO_BYTES=314572800 # consent-time download of the training video

# ---- services ----
OLLAMA_URL=http://localhost:11434
MIRAGE_LIPSYNC_URL=http://localhost:8100
MIRAGE_LIPSYNC_DEVICE=                 # cuda | mps | cpu ; empty = auto

# ---- payments (leave empty to disable; checkout then returns 501) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MIRAGE_USD_INR=85
