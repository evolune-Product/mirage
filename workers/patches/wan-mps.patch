     return _t5('umt5-xxl', **cfg)
 
 
+def load_comfy_umt5_fp8(path, dtype):
+    """Load Comfy-Org's umt5_xxl_fp8_e4m3fn_scaled.safetensors (HF key names, fp8 + per-tensor scale)
+    into Wan's T5Encoder key layout, dequantised on CPU (saves a 11 GB download)."""
+    from safetensors import safe_open
+    sd = {}
+    with safe_open(path, 'pt', device='cpu') as f:
+        keys = set(f.keys())
+        for k in keys:
+            if k in ('scaled_fp8', 'spiece_model') or k.endswith('scale_weight'):
+                continue
+            t = f.get_tensor(k)
+            if t.dtype == torch.float8_e4m3fn:
+                t = t.to(torch.float32) * f.get_tensor(k[:-len('weight')] + 'scale_weight').to(torch.float32)
+            t = t.to(dtype)
+            if k == 'shared.weight':
+                nk = 'token_embedding.weight'
+            elif k == 'encoder.final_layer_norm.weight':
+                nk = 'norm.weight'
+            else:
+                p = k.split('.')  # encoder.block.N.layer.L.<...>
+                n, rest = p[2], '.'.join(p[3:])
+                nk = 'blocks.%s.' % n + (rest
+                    .replace('layer.0.layer_norm', 'norm1').replace('layer.1.layer_norm', 'norm2')
+                    .replace('layer.0.SelfAttention.relative_attention_bias', 'pos_embedding.embedding')
+                    .replace('layer.0.SelfAttention.', 'attn.')
+                    .replace('layer.1.DenseReluDense.wi_0', 'ffn.gate.0')
+                    .replace('layer.1.DenseReluDense.wi_1', 'ffn.fc1')
+                    .replace('layer.1.DenseReluDense.wo', 'ffn.fc2'))
+            sd[nk] = t
+    return sd
+
+
 class T5EncoderModel:
 
     def __init__(
         self,
         text_len,
         dtype=torch.bfloat16,
-        device=torch.cuda.current_device(),
+        device='cpu',  # MPS patch: was torch.cuda.current_device()
         checkpoint_path=None,
         tokenizer_path=None,
         shard_fn=None,
