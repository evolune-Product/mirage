# Mirage dashboard + marketing site (Next.js 14).  docker build -f infra/Dockerfile.web \
#   --build-arg NEXT_PUBLIC_API_URL=https://api.example.com -t mirage-web .
# NEXT_PUBLIC_* values are baked into the JS at build time: rebuild when the API URL changes. UNTESTED.
FROM node:20-slim AS build
WORKDIR /app
COPY web/package.json web/package-lock.json* ./
RUN npm ci || npm install
COPY web ./
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:20-slim
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --from=build /app ./
USER node
EXPOSE 3000
CMD ["npx", "next", "start", "-p", "3000"]
